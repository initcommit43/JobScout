# Vorlage fuer .env — kopieren nach .env und ausfuellen.
# .env ist git-ignoriert. Hier stehen NUR leere Platzhalter, niemals echte Werte.
#
#   cp .env.example .env
#
# Es muss nur der Schluessel des Anbieters gesetzt sein, der in config/settings.json
# tatsaechlich ausgewaehlt ist. Alles andere darf leer bleiben.

# --- KI-Anbieter (siehe config/anbieter.example.json) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
HUNYUAN_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# Ollama laeuft lokal und braucht keinen Schluessel.

# --- Mail (Gmail, App-Passwort; setzt 2FA im Google-Konto voraus) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Auf true protokolliert der Versand nur, statt zu senden. In Tests immer true.
MAIL_DRY_RUN=true

# --- Server ---
PORT=5173
