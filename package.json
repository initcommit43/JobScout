{
  "name": "bewerbungsbot",
  "version": "0.1.0",
  "description": "Lokaler Bewerbungsassistent: Stellen holen, filtern, Anschreiben erzeugen, versenden",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "scrape": "node --import tsx --env-file-if-exists=.env scripts/scrape.ts",
    "test": "node --import tsx --test --test-reporter spec \"test/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch --test-reporter spec \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.1",
    "eslint": "10.10.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.124.0",
    "@google/genai": "2.21.0",
    "openai": "7.10.0",
    "playwright": "1.62.1",
    "zod": "4.5.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@google/genai@2.21.0": true,
    "protobufjs@7.6.6": true
  }
}
